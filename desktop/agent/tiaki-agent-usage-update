#!/bin/bash

# tiaki:summary=Regenerate the AI agent usage data files
# tiaki:args=[--force] [--limits-only] [--except <agent>] [agent...]
# tiaki:examples=tiaki agent usage-update | tiaki agent usage-update claude | tiaki agent usage-update --except codex

# Each tiaki-agent-usage-<agent> collector prints one display-ready JSON
# record; this writes them to ~/.local/state/tiaki/agents/usage/ where the
# Tiaki shell watches them. Adding an agent is adding a collector.

USAGE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/tiaki/agents/usage"
mkdir -p "$USAGE_DIR"

# Sibling collectors live beside this script (normally /usr/local/bin);
# TIAKI_AGENT_BIN overrides for dev checkouts.
BIN_DIR="${TIAKI_AGENT_BIN:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"

flags=()
only=()
declare -A excluded

while (( $# > 0 )); do
  case "$1" in
  --force | --limits-only) flags+=("$1") ;;
  --except)
    excluded[$2]=1
    shift
    ;;
  *) only+=("$1") ;;
  esac
  shift
done

wanted() {
  local agent="$1"
  [[ -n ${excluded[$agent]} ]] && return 1
  (( ${#only[@]} == 0 )) && return 0
  local candidate
  for candidate in "${only[@]}"; do
    [[ $candidate == "$agent" ]] && return 0
  done
  return 1
}

collect() {
  local collector="$1" agent="$2"
  local record tmp
  if ! record=$("$collector" "${flags[@]}") || [[ -z $record ]] || ! jq -e . >/dev/null 2>&1 <<<"$record"; then
    echo "tiaki-agent-usage-update: $agent collector failed" >&2
    return 1
  fi
  tmp=$(mktemp "$USAGE_DIR/.$agent.XXXXXX")
  printf '%s\n' "$record" >"$tmp"
  mv "$tmp" "$USAGE_DIR/$agent.json"
}

# Accounts can be signed in to someone else since they were added; the
# records name them from the registry, so bring it up to date first.
accounts_dir="${XDG_STATE_HOME:-$HOME/.local/state}/tiaki/agents/accounts"
if [[ -d $accounts_dir ]]; then
  "$BIN_DIR/tiaki-agent-account-state" refresh
fi

# Collectors forced together read the Codex rollouts they share once between
# them, whenever each gets to them, by knowing when this refresh began.
# EPOCHREALTIME uses the locale's decimal separator, a comma in many.
export TIAKI_AGENT_USAGE_REFRESH_AT=${EPOCHREALTIME/,/.}

pids=()
for collector in "$BIN_DIR"/tiaki-agent-usage-*; do
  [[ -x $collector ]] || continue
  agent="${collector##*/tiaki-agent-usage-}"
  [[ $agent == "update" ]] && continue
  wanted "$agent" || continue
  collect "$collector" "$agent" &
  pids+=($!)
done

status=0
for pid in "${pids[@]}"; do
  wait "$pid" || status=1
done

# Fresh limits are when switching accounts near a limit gets decided. A switch
# changes which account the record's own limits describe, so that record is
# collected once more; the limits probes it repeats are still cached.
for agent in claude codex grok; do
  if wanted "$agent" && [[ -f $accounts_dir/$agent.json ]]; then
    switched=$("$BIN_DIR/tiaki-agent-account-state" autoswitch "$agent")
    if [[ -n $switched ]]; then
      flags=(--limits-only)
      collect "$BIN_DIR/tiaki-agent-usage-$agent" "$agent" || status=1
    fi
  fi
done

exit $status
