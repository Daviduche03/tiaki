#!/bin/bash

# tiaki:summary=Launch the default coding agent with a prompt
# tiaki:args=[--inline] <prompt...>
# tiaki:examples=tiaki agent prompt "Review this project"

# Prompts live here rather than on `tiaki agent`, where a bare prompt would
# shadow the subcommands under that group.

set -euo pipefail

inline=()
if [[ ${1:-} == "--inline" ]]; then
  inline=(--inline)
  shift
fi

if (($# == 0)); then
  echo "Usage: tiaki agent prompt [--inline] <prompt...>" >&2
  exit 1
fi

exec tiaki-agent "${inline[@]}" --prompt "$*"
