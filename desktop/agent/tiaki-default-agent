#!/bin/bash

# tiaki:summary=Set and launch the default coding agent
# tiaki:args=[pi|omp|opencode|ori|claude|codex|grok|openclaw|agy|hermes|copilot|crush|cursor-agent|muse|kimi|qwen|dsh|mcode|kiro-cli|freebuff|kilo|devin|amp|commandcode]
# tiaki:examples=tiaki-default-agent | tiaki-default-agent codex | tiaki-default-agent claude

agent_file="$HOME/.config/tiaki/defaults/agent"

if (($# == 0)); then
  if [[ -f $agent_file ]]; then
    read -r agent <"$agent_file"
  fi

  # Silent when unset rather than defaulting: Tiaki picks no agent for you.
  [[ -n ${agent:-} ]] && echo "$agent"
  exit 0
fi

case "$1" in
pi) agent="pi"; name="Pi" ;;
omp | oh-my-pi) agent="omp"; name="Oh My Pi" ;;
opencode | open-code) agent="opencode"; name="OpenCode" ;;
ori | openrouter) agent="ori"; name="Ori" ;;
claude | claude-code) agent="claude"; name="Claude Code" ;;
codex) agent="codex"; name="Codex" ;;
crush) agent="crush"; name="Crush" ;;
grok) agent="grok"; name="Grok" ;;
openclaw) agent="openclaw"; name="OpenClaw" ;;
agy | antigravity | antigravity-cli | gemini | gemini-cli) agent="agy"; name="Antigravity" ;;
hermes) agent="hermes"; name="Hermes" ;;
copilot | github-copilot) agent="copilot"; name="GitHub Copilot" ;;
muse | muse-code | musecode) agent="muse"; name="Muse Code" ;;
cursor | cursor-agent) agent="cursor-agent"; name="Cursor CLI" ;;
kimi | kimi-code) agent="kimi"; name="Kimi" ;;
qwen | qwen-code) agent="qwen"; name="Qwen Code" ;;
dsh | deepseek | deepseek-harness) agent="dsh"; name="DeepSeek Harness" ;;
mcode | minimax-code | minimax) agent="mcode"; name="MiniMax Code" ;;
kiro-cli | kiro) agent="kiro-cli"; name="Kiro CLI" ;;
freebuff) agent="freebuff"; name="Freebuff" ;;
kilo | kilocode | kilo-code) agent="kilo"; name="Kilo" ;;
devin | devin-cli) agent="devin"; name="Devin CLI" ;;
amp | ampcode) agent="amp"; name="Amp" ;;
commandcode | command-code | cmdc) agent="commandcode"; name="Command Code" ;;
*)
  echo "Usage: tiaki-default-agent <pi|omp|opencode|ori|claude|codex|grok|openclaw|agy|hermes|copilot|crush|cursor-agent|muse|kimi|qwen|dsh|mcode|kiro-cli|freebuff|kilo|devin|amp|commandcode>"
  exit 1
  ;;
esac

# Tiaki does not auto-install agents: if the harness isn't on PATH, say how
# to get it rather than fetching anything. A user install in ~/.local/bin
# counts the same as one on PATH.
agent_present() { tiaki-cmd-present "$agent" || [[ -x $HOME/.local/bin/$agent ]]; }

if ! agent_present; then
  echo "$name is not installed. Install it, then run: tiaki-default-agent $agent" >&2
  exit 1
fi

mkdir -p "$(dirname "$agent_file")"
printf '%s\n' "$agent" >"$agent_file"

# The harness reads the shared ~/.agents/AGENTS.md from its first session.
tiaki-agent-instructions "$agent" >/dev/null || true

exec tiaki-agent
