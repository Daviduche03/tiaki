#!/bin/bash

# tiaki:summary=Launch a TUI command in the default terminal with Tiaki styling
# tiaki:args=[--app-id=<app-id>] <command> [args...]

# Sway-native launcher: sched-launch starts foot with our config, one window
# per call. The app-id keeps agent windows in one class for window rules.
if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
  shift
else
  APP_ID="org.tiaki.$(basename $1)"
fi

exec sched-launch --class foreground --name "$APP_ID" -- foot -c /etc/tiaki/foot.ini --app-id "$APP_ID" -e "$1" "${@:2}"
