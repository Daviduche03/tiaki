#!/bin/bash

# tiaki:summary=Launch the default browser as determined by xdg-settings.
# tiaki:args=[--private] [url]

# Resolves the default browser the same way every Tiaki script does:
# xdg-settings, then Exec= from its .desktop entry.
url=""
private=false
for arg in "$@"; do
  case "$arg" in
  --private) private=true ;;
  *) url="$arg" ;;
  esac
done

entry=$(xdg-settings get default-web-browser 2>/dev/null)
browser_exec=""
if [[ -n $entry ]]; then
  IFS=: read -ra data_dirs <<<"${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  for data_dir in "${data_dirs[@]}"; do
    [[ -f $data_dir/applications/$entry ]] || continue
    browser_exec=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' "$data_dir/applications/$entry" | head -1)
    break
  done
fi

if [[ -z $browser_exec ]]; then
  echo "tiaki-launch-browser: no default browser found; set one with 'xdg-settings set default-web-browser <entry>'" >&2
  tiaki-notify --error "No default browser found" "Set one, then try again."
  exit 1
fi

# Only a private launch needs the browser's flag, and probing a Firefox-family
# browser's --help starts the whole binary, so ordinary launches skip it and
# leave their arguments as they are.
args=()
if [[ $private == "true" ]]; then
  if $browser_exec --help 2>/dev/null | grep -q MOZ_LOG; then
    args+=(--private-window)
  elif [[ $browser_exec =~ edge ]]; then
    args+=(--inprivate)
  else
    args+=(--incognito)
  fi
fi
[[ -n $url ]] && args+=("$url")

# Detached: the login flow that opens this URL outlives the terminal.
setsid --fork "$browser_exec" "${args[@]}" >/dev/null 2>&1
