#!/bin/bash

# tiaki:summary=Forget an added Claude, Codex, or Grok account
# tiaki:args=[claude|codex|grok] <account>
# tiaki:examples=tiaki agent account remove work | tiaki agent account remove codex side

set -uo pipefail

# The provider can be left out when it's your default agent:
# `tiaki agent account use work`.
if [[ ${1:-} != "claude" && ${1:-} != "codex" && ${1:-} != "grok" ]]; then
  default=$(tiaki-default-agent)
  [[ $default == "claude" || $default == "codex" || $default == "grok" ]] && set -- "$default" "$@"
fi

if [[ ${1:-} != "claude" && ${1:-} != "codex" && ${1:-} != "grok" ]] || [[ -z ${2:-} ]]; then
  echo "Usage: tiaki-agent-account-remove [claude|codex|grok] <account>" >&2
  exit 1
fi

# Removing only deletes the account's home here. It never logs out, which
# would revoke the sign-in for every other copy of it too.
if [[ -t 0 ]]; then
  printf 'Forget the %s account %s? [y/N] ' "$1" "$2"
  read -r ok || exit 130
  [[ $ok == [yY]* ]] || exit 130
fi

account=$(tiaki-agent-account-state remove "$1" "$2") || exit 1
echo "Forgot $(jq -r .label <<<"$account")."
# The panel reads which accounts exist from the usage record.
tiaki-agent-usage-update --limits-only "$1" >/dev/null 2>&1 &
