[Unit]
Description=Tiaki graphical session (Hyprland + Omarchy chrome)
After=tiaki-ui-serve.service
Requires=tiaki-ui-serve.service
Conflicts=tiaki-session.service

[Service]
# Root takes the DRM master: no seatd/logind user session exists on this
# rig yet. See tiaki-hyprland-session; a user+seatd session is the
# followup. Sway stays installed but disabled as the fallback.
User=root
Environment=XDG_RUNTIME_DIR=/run/tiaki-hyprland
Environment=HOME=/root
Environment=OMARCHY_PATH=/usr/share/omarchy
Environment=XDG_CURRENT_DESKTOP=Tiaki
Environment=XDG_SESSION_TYPE=wayland
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=QT_QPA_PLATFORM=wayland
RuntimeDirectory=tiaki-hyprland
ExecStart=/usr/local/bin/tiaki-hyprland-session
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
