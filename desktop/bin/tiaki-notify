#!/bin/sh
# tiaki-notify — put something in the notification center.
#
#   tiaki-notify "Title" "Body"
#   tiaki-notify --approval "Agent wants network access" "guarded mode · run 8f3a"
#   tiaki-notify --error "Rollback failed" "generation b is unchanged"
#
# Kinds: info (default), approval, error. The bar shows a lamp chip while an
# approval is outstanding, so use --approval only for something a principal
# must actually decide.
set -eu

kind=info
case "${1:-}" in
  --approval) kind=approval; shift ;;
  --error)    kind=error;    shift ;;
  --info)     kind=info;     shift ;;
  --help|-h)
    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
    exit 0 ;;
esac

title="${1:-}"
body="${2:-}"
if [ -z "$title" ]; then
  echo "usage: tiaki-notify [--approval|--error] \"Title\" [\"Body\"]" >&2
  exit 2
fi

state="${XDG_STATE_HOME:-${HOME:-/home/desktop}/.local/state}/tiaki/notifications"
mkdir -p "$state"

# <epoch>-<kind>.txt — the shell sorts by name, so newest sorts first.
file="$state/$(date +%s)-$kind.txt"
printf '%s\n%s\n' "$title" "$body" > "$file"

printf 'notified: %s\n' "$file"
