<?xml version="1.0" encoding="UTF-8"?>
<!-- Tiaki's default source-view scheme. Ink canvas, paper text, the lamp
     for the current line and matches. This file replaces upstream
     classic.xml: on Tiaki the out-of-box default is dark, so `classic`
     keeps its id (every client default-selects it) and wears Tiaki.
     Spec: docs/design/brand/color.md -->

<style-scheme id="classic" _name="Tiaki" version="1.0">

  <author>Tiaki</author>
  <_description>Tiaki default: ink canvas, paper text, lamp accents</_description>

  <!-- Tiaki base -->
  <color name="ink"          value="#151413"/>
  <color name="ink-raised"   value="#1B1917"/>
  <color name="paper"        value="#E6E0D4"/>
  <color name="paper-dim"    value="#A39C8D"/>
  <color name="ink-3"        value="#665F54"/>
  <color name="lamp"         value="#D08A2C"/>
  <color name="lamp-deep"    value="#6B4E1E"/>
  <color name="kept"         value="#2E6B4E"/>
  <color name="refused"      value="#A23B2A"/>

  <!-- Muted token hues, readable on ink (content, not chrome) -->
  <color name="sky1"         value="#729fcf"/>
  <color name="cham1"        value="#8ae234"/>
  <color name="butter2"      value="#edd400"/>
  <color name="orange3"      value="#fcaf3e"/>
  <color name="plum1"        value="#ad7fa8"/>
  <color name="alum1"        value="#eeeeec"/>

  <style name="text"                       foreground="paper" background="ink"/>
  <style name="selection"                 foreground="paper" background="lamp-deep"/>
  <style name="cursor"                    foreground="paper"/>
  <style name="secondary-cursor"           foreground="paper-dim"/>
  <style name="current-line"              background="ink-raised"/>
  <style name="line-numbers"              foreground="ink-3" background="ink"/>
  <style name="draw-spaces"               foreground="ink-3"/>
  <style name="background-pattern"        background="ink"/>

  <!-- Bracket Matching -->
  <style name="bracket-match"             foreground="lamp"/>
  <style name="bracket-mismatch"          foreground="paper" background="refused"/>

  <!-- Right Margin -->
  <style name="right-margin"              foreground="paper" background="ink-3"/>

  <!-- Search Matching -->
  <style name="search-match"              foreground="ink" background="lamp"/>

  <!-- Comments -->
  <style name="def:comment"               foreground="ink-3"/>
  <style name="def:shebang"               foreground="ink-3" bold="true"/>
  <style name="def:doc-comment-element"   italic="true"/>

  <!-- Constants -->
  <style name="def:constant"              foreground="butter2"/>
  <style name="def:string"                foreground="butter2"/>
  <style name="def:special-char"          foreground="orange3"/>
  <style name="def:special-constant"      foreground="orange3"/>
  <style name="def:floating-point"        foreground="orange3"/>

  <!-- Identifiers -->
  <style name="def:identifier"            foreground="sky1"/>

  <!-- Statements -->
  <style name="def:statement"             foreground="paper" bold="true"/>

  <!-- Types -->
  <style name="def:type"                  foreground="cham1" bold="true"/>

  <!-- Markup -->
  <style name="def:emphasis"              italic="true"/>
  <style name="def:strong-emphasis"       foreground="paper" bold="true"/>
  <style name="def:inline-code"           foreground="sky1"/>
  <style name="def:insertion"             underline="single"/>
  <style name="def:deletion"              strikethrough="true"/>
  <style name="def:link-text"             foreground="ink-3"/>
  <style name="def:link-symbol"           foreground="ink-3" bold="true"/>
  <style name="def:link-destination"      italic="true" underline="single"/>
  <style name="def:heading"               foreground="cham1" bold="true"/>
  <style name="def:thematic-break"        foreground="cham1" bold="true"/>
  <style name="def:preformatted-section"  foreground="sky1"/>
  <style name="def:list-marker"           foreground="paper" bold="true"/>

  <!-- Others -->
  <style name="def:preprocessor"          foreground="plum1"/>
  <style name="def:error"                 foreground="paper" background="refused" bold="true"/>
  <style name="def:warning"               foreground="ink" background="lamp"/>
  <style name="def:note"                  background="butter2" foreground="ink-3" bold="true"/>
  <style name="def:net-address"           italic="true" underline="single"/>

  <!-- Language specific -->
  <style name="diff:added-line"           foreground="kept"/>
  <style name="diff:removed-line"         foreground="sky1"/>
  <style name="diff:changed-line"         foreground="plum1"/>
  <style name="diff:diff-file"            foreground="cham1" bold="true"/>
  <style name="diff:location"             foreground="cham1"/>
  <style name="diff:special-case"         foreground="paper" bold="true"/>

  <style name="latex:command"             foreground="cham1" bold="true"/>
  <style name="latex:include"             use-style="def:preprocessor"/>

</style-scheme>
