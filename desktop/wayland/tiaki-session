#!/bin/sh
# Tiaki's graphical session.
#
# One compositor runs in the foreground so systemd tracks the session by it.
# The wallpaper, the remote server and the sign-in screen wait in the
# background for the Wayland socket, then start in that order.
#
# ShojiWM drives DRM/KMS directly (`--tty`). A machine without a DRM device —
# the QEMU harness, a container — cannot host it, so the same session falls
# back to Sway's headless backend. That is a capability check, not a second
# product: the fallback exists so the image boots everywhere it is tested.
set -eu

runtime="${XDG_RUNTIME_DIR:-/run/tiaki}"
export XDG_RUNTIME_DIR="$runtime"

start_surfaces() {
    /usr/local/bin/sched-launch --class foreground -- \
        /usr/local/bin/tiaki-shell bar || true &
    /usr/local/bin/sched-launch --class foreground -- \
        /usr/local/bin/tiaki-shell dock || true &
    /usr/local/bin/sched-launch --class foreground -- \
        /usr/local/bin/tiaki-shell chrome || true &
}

output_size() {
    # sway sets SWAYSOCK for its own children; this watcher is started by the
    # session before sway runs, so it finds the socket itself.
    if [ -z "${SWAYSOCK:-}" ]; then
        SWAYSOCK=$(ls "$runtime"/sway-ipc.* 2>/dev/null | head -1)
        [ -n "$SWAYSOCK" ] || return 1
        export SWAYSOCK
    fi
    /usr/bin/swaymsg -t get_outputs -r 2>/dev/null | /usr/bin/python3 -c '
import json, sys
try:
    outputs = json.load(sys.stdin)
except Exception:
    sys.exit(1)
print(" ".join("%s=%sx%s" % (o.get("name"), o["rect"]["width"], o["rect"]["height"])
               for o in outputs))
'
}

watch_output_size() {
    last=""
    while :; do
        size=$(output_size || true)
        if [ -n "$size" ]; then
            if [ -n "$last" ] && [ "$size" != "$last" ]; then
                start_surfaces
                # greet is the sign-in screen; restart it only while it is
                # still up, never over a desktop someone is already using.
                if pgrep -x tiaki-shell >/dev/null && pgrep -af "tiaki-shell greet" >/dev/null; then
                    pkill -f "tiaki-shell greet" || true
                    /usr/local/bin/sched-launch --class foreground -- \
                        /usr/local/bin/tiaki-shell greet || true &
                fi
            fi
            last="$size"
        fi
        sleep 4
    done
}

start_inside() {
    socket=""
    tries=0
    while [ -z "$socket" ] && [ "$tries" -lt 200 ]; do
        for candidate in "$runtime"/wayland-*; do
            case "$candidate" in
                *.lock) continue ;;
            esac
            if [ -S "$candidate" ]; then
                socket="${candidate##*/}"
                break
            fi
        done
        [ -n "$socket" ] || sleep 0.1
        tries=$((tries + 1))
    done
    if [ -z "$socket" ]; then
        echo "tiaki-session: no Wayland socket appeared" >&2
        return 1
    fi
    export WAYLAND_DISPLAY="$socket"

    # Background helpers are throttled first; the sign-in screen is
    # foreground so the UI stays responsive while the session starts.
    /usr/local/bin/sched-launch --class background -- \
        /usr/local/bin/tiaki-wallpaper init || true
    # sched-launch supervises in the foreground (child.wait), so the
    # background helpers must be detached here or the sign-in screen below
    # never starts. The wallpaper one exits on its own (it spawns swaybg);
    # wayvnc runs forever and would block greet without the &.
    /usr/local/bin/sched-launch --class background -- \
        wayvnc -C /etc/tiaki/wayvnc.conf || true &
    # The bar, dock and chrome are surfaces of the shell. greet spawns them
    # again at sign-in (it opens a few welcome windows too), and each surface
    # replaces its predecessor through its runtime lock — one quick relaunch,
    # then stable. Starting them here as well means a session that never
    # reaches the sign-in spawn still has chrome: Sway draws no titlebars of
    # its own, so without the overlay every window is borderless and has no
    # traffic lights.
    start_surfaces

    # A layer surface keeps the size it was created with when the output is
    # resized underneath it: the bar stops short of the new edge, the dock is
    # pushed off the bottom, greet leaves wallpaper strips down the sides.
    # Remote viewers resize the output whenever the window does, so watch it
    # and hand the surfaces a fresh geometry. Each is replaced through its
    # lock, and greet is only restarted while it is still the sign-in screen.
    watch_output_size &

    /usr/local/bin/sched-launch --class foreground -- \
        /usr/local/bin/tiaki-shell greet || true
}

start_inside &

if [ -e /dev/dri/card0 ]; then
    exec /usr/local/bin/tiaki-wm --tty
fi

exec sway -c /etc/tiaki/sway.conf
