#!/bin/sh
# Tiaki Hyprland session (Omarchy chrome).
#
# The product session alongside the Sway fallback (see tiaki-session):
# Hyprland owns the DRM master and composites with llvmpipe where there
# is no GPU; the Omarchy Quickshell shell draws bar, menu, dock and
# notifications; our Rust daemons are untouched.
#
# Runs as root: taking DRM master needs a logind seat or root, and this
# rig has neither seatd nor user logind sessions. A seatd/logind-based
# user session is the image-build followup; root is the proven path.
# Conflicts with tiaki-session.service: only one compositor at a time.
#
# Quickshell itself is started by Hyprland's autostart (tiaki-launch-shell,
# which supervises and restarts it) — not here, so there is exactly one
# supervisor and it only runs once the compositor is up.
set -eu

runtime="${XDG_RUNTIME_DIR:-/run/tiaki-hyprland}"
export XDG_RUNTIME_DIR="$runtime"
export HOME=/root
export OMARCHY_PATH=/usr/share/omarchy
export XDG_CURRENT_DESKTOP=Tiaki
export XDG_SESSION_TYPE=wayland
export LANG=C.UTF-8
export LC_ALL=C.UTF-8

mkdir -p "$runtime"
chmod 700 "$runtime"

# Session bus (the image has no user systemd here to provide one).
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    addr=$(dbus-daemon --session --print-address=1 --print-pid=1 --fork 2>/dev/null | head -n 1)
    export DBUS_SESSION_BUS_ADDRESS="$addr"
fi

# Sound server + session manager for the bar's audio indicators.
pgrep -x pipewire >/dev/null || nohup pipewire >/var/log/tiaki-pipewire.log 2>&1 &
sleep 2
pgrep -x wireplumber >/dev/null || nohup wireplumber >/var/log/tiaki-wireplumber.log 2>&1 &
sleep 2

start_inside() {
    socket=""
    tries=0
    while [ -z "$socket" ] && [ "$tries" -lt 200 ]; do
        if [ -S "$runtime/wayland-1" ]; then
            socket="wayland-1"
            break
        fi
        sleep 0.5
        tries=$((tries + 1))
    done
    if [ -z "$socket" ]; then
        echo "tiaki-hyprland-session: no Wayland socket appeared" >&2
        return 1
    fi
    export WAYLAND_DISPLAY="$socket"

    # Remote access to the Hyprland session (grey frame until the
    # screencopy path is fixed; grim verifies meanwhile).
    wayvnc -C /etc/tiaki/wayvnc.conf || true &
}

start_inside &

exec /usr/bin/Hyprland --i-am-really-stupid -c /usr/share/omarchy/hyprland.lua
